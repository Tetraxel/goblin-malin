# Goblin Malin — example `.env`
#
# The app asks for these values in its setup prompts and saves them for you, so you rarely need to create this
# file by hand. If you do, copy the lines you need into `.env` inside the app's data folder:
#   Windows   %APPDATA%\goblin-malin\.env
#   macOS     ~/Library/Application Support/goblin-malin/.env
#   Linux     ${XDG_DATA_HOME:-~/.local/share}/goblin-malin/.env
#   dev       <repo>/data/.env   (yarn run dev)
# Never commit a real `.env`.

# --- Spotify — https://developer.spotify.com/dashboard
# official = your own Spotify API app (CLIENT_ID / CLIENT_SECRET below; needs a Premium account),
#            gives the best metadata (album, ISRC, track number).
# scrape   = no credentials, reads the public web page; limited metadata (no album, no ISRC).
SPOTIFY_AUTH_MODE=official
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Soulseek — https://www.slsknet.org/
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# --- Environment variables of the process itself (set them in your shell, NOT in this file — this file lives
# --- inside the data folder they would have to locate)
#   GOBLIN_DATA_DIR=<folder>   Use this folder for settings, sessions, cache, tools and the log instead of the
#                              default data folder above.
#   GOBLIN_NO_AUDIO=1          Never start mpv: no preview playback, no intro sound.
