{
    "name": "goblin-malin",
    "version": "0.2.1",
    "description": "A keyboard-driven terminal UI for downloading and tagging music tracks with metadata from Spotify and YouTube",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "imports": {
        "#base": "./src/base/index.ts",
        "#base/*": "./src/base/*.ts",
        "#components": "./src/components/index.ts",
        "#components/*": "./src/components/*.ts",
        "#constants": "./src/constants.ts",
        "#contexts": "./src/contexts/index.ts",
        "#contexts/*": "./src/contexts/*.ts",
        "#exceptions": "./src/exceptions/index.ts",
        "#exceptions/*": "./src/exceptions/*.ts",
        "#flows": "./src/flows/index.ts",
        "#flows/*": "./src/flows/*.ts",
        "#hooks": "./src/hooks/index.ts",
        "#hooks/*": "./src/hooks/*.ts",
        "#sessions": "./src/sessions/index.ts",
        "#sessions/*": "./src/sessions/*.ts",
        "#settings": "./src/settings/index.ts",
        "#settings/*": "./src/settings/*.ts",
        "#updater/*": "./src/updater/*.ts",
        "#utils": "./src/utils/index.ts",
        "#utils/*": "./src/utils/*.ts",
        "#assets/*": "./src/assets/*",
        "#types": "./src/types/index.ts",
        "#types/*": "./src/types/*.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "bin": {
        "goblin-malin": "dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "scripts/save-install-source.mjs"
    ],
    "scripts": {
        "dev": "cross-env NODE_ENV=development tsx src/cli.ts",
        "start": "cross-env NODE_ENV=production tsx src/cli.ts",
        "build": "tsup",
        "type-check": "tsc --noEmit && tsc --noEmit --project scripts/tui-test/tsconfig.json",
        "probe:songlink": "node scripts/songlink-rate-probe.mjs",
        "test:spotify-url-info": "node scripts/spotify-url-info-test.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run tests/unit --coverage",
        "test:watch": "vitest",
        "test:tui": "tsx scripts/tui-test/cli.ts",
        "type-check:src": "tsc --noEmit",
        "type-check:tui": "tsc --noEmit --project scripts/tui-test/tsconfig.json",
        "lint": "eslint src/ tests/ scripts/",
        "check:utf8": "node scripts/check-utf8.mjs",
        "format": "prettier --write src/ tests/ scripts/",
        "format:check": "prettier --check src/ tests/ scripts/",
        "postinstall": "node scripts/save-install-source.mjs",
        "prepublishOnly": "tsup"
    },
    "keywords": [
        "music",
        "download",
        "downloader",
        "tui",
        "cli",
        "terminal",
        "spotify",
        "youtube",
        "yt-dlp",
        "metadata",
        "tags",
        "ink",
        "react"
    ],
    "author": "Tetraxel",
    "license": "SEE LICENSE IN LICENSE",
    "engines": {
        "node": ">=22"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tetraxel/goblin-malin.git"
    },
    "homepage": "https://github.com/Tetraxel/goblin-malin#readme",
    "bugs": {
        "url": "https://github.com/Tetraxel/goblin-malin/issues"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@napi-rs/canvas": "^1.1.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@vitest/coverage-v8": "5.1.0",
        "@xterm/addon-unicode11": "^0.9.0",
        "@xterm/headless": "^6.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "node-pty": "^1.1.0",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "7zip-bin": "^5.2.0",
        "@spotify/web-api-ts-sdk": "^1.2.0",
        "adm-zip": "^0.6.1",
        "cli-truncate": "^6.2.0",
        "clipboardy": "^5.3.2",
        "dotenv": "^18.0.9",
        "flac-tagger": "^2.1.0",
        "flat-cache": "^6.1.23",
        "ink": "^8.0.0",
        "ink-select-input": "^6.2.0",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^6.0.0",
        "musicbrainz-api": "^2.0.1",
        "node-id3": "^0.2.9",
        "open": "^11.0.4",
        "react": "^19.3.1",
        "slsk-client": "^2.0.2",
        "spotify-url-info": "^3.3.3",
        "string-width": "^8.2.1",
        "strip-ansi": "^7.2.0",
        "winston": "^3.19.0",
        "winston-transport": "^4.9.0",
        "wrap-ansi": "^10.0.2",
        "ytdlp-nodejs": "^3.4.5",
        "ytmusic-api": "^5.3.1"
    },
    "resolutions": {
        "**/@typescript-eslint/typescript-estree/minimatch": "^11.0.1"
    }
}
