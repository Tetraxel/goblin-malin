        { "type": "assert", "contains": "Model sonnet" },
        { "type": "startLoad" },
        { "type": "wait", "ms": 700 },
        { "type": "stopLoad" },
        { "type": "wait", "ms": 600 },
        { "type": "key", "key": "PageUp" },
        { "type": "key", "key": "PageUp" },
        { "type": "key", "key": "PageUp" },
        { "type": "key", "key": "PageUp" },
        { "type": "waitForContent", "text": "▸ get_task", "timeout": 3000 },
        { "type": "snapshot", "name": "tool-closed" },
        { "type": "key", "key": "Ctrl+O" },
        { "type": "waitForContent", "text": "\"revision\":42", "timeout": 3000 },
