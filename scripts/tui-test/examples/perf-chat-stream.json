{
    "name": "perf-chat-stream",
    "terminal": {
        "cols": 128,
        "rows": 50
    },
    "dataDir": "scripts/tui-test/fixtures/50-tasks-with-metadata",
    "load": {
        "chatWordsPerTick": 3,
        "tickMs": 50
    },
    "profile": {
        "enabled": true,
        "thresholds": {
            "maxCommitsPerInteraction": 80,
            "maxWastedRendersPerInteraction": 200
        }
    },
    "steps": [
        {
            "type": "stable",
            "timeout": 40000,
            "quiescenceMs": 1000
        },
        {
            "type": "waitForContent",
            "text": "Hooked",
            "timeout": 20000
        },
        {
            "type": "key",
            "key": "Ctrl+T"
        },
        {
            "type": "waitForContent",
            "text": "Message Claude",
            "timeout": 5000
        },
        {
            "type": "mark",
            "label": "chat open, idle"
        },
        {
            "type": "wait",
            "ms": 3000
        },
        {
            "type": "startLoad"
        },
        {
            "type": "mark",
            "label": "answer streaming (60 words/s)"
        },
        {
            "type": "wait",
            "ms": 10000
        },
        {
            "type": "stopLoad"
        },
        {
            "type": "wait",
            "ms": 1500
        }
    ]
}
