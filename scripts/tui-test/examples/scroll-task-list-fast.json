{
    // A held ↓ (keys 35 ms apart, like a terminal's autorepeat): no key is lost, the cursor ends exactly where 30
    // presses take it, and the screen settles on the right rows.
    "terminal": { "cols": 128, "rows": 50 },
    "dataDir": "scripts/tui-test/fixtures/50-tasks-with-metadata",
    "steps": [
        { "type": "stable", "timeout": 8000 },
        { "type": "waitForContent", "text": "Hooked", "timeout": 5000 },
        { "type": "snapshot", "name": "initial" },

        { "type": "key", "key": "ArrowDown" },
        { "type": "stable" },

        { "type": "key", "key": "ArrowDown", "repeat": 30, "delayMs": 35 },
        { "type": "stable" },
        { "type": "assert", "contains": "Task 30/50" },
        { "type": "assert", "matches": "☛.*Rome Is Bur" },
        { "type": "assert", "matches": "☛", "count": 1 },
        { "type": "snapshot", "name": "scrolled-fast" },

        // And back up as fast: on the first task again, at the top of the list.
        { "type": "key", "key": "ArrowUp", "repeat": 29, "delayMs": 35 },
        { "type": "stable" },
        { "type": "assert", "contains": "Task 1/50" },
        { "type": "assert", "matches": "☛.*NOTION\\s+Hooked", "row": 5 }
    ]
}
