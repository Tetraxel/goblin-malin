{
    "terminal": { "cols": 128, "rows": 64 },
    "dataDir": "scripts/tui-test/fixtures/empty",
    "steps": [
        { "type": "stable", "timeout": 8000 },
        { "type": "waitForContent", "text": "No task to run", "timeout": 5000 },
        { "type": "snapshot", "name": "initial" },

        // Toolbar order: Run, Actions, Claude, Sessions, Archive, Settings, Exit: Settings is 5 presses of → from the start.
        { "type": "key", "key": "ArrowRight", "repeat": 5 },
        { "type": "key", "key": "Enter" },
        { "type": "stable" },
        // "Settings" is a permanent toolbar label, so assert on text only the modal shows.
        { "type": "assert", "contains": "Search settings" },
        { "type": "snapshot", "name": "settings-open" },
        { "type": "screenshot", "name": "settings-open" },
        { "type": "screenshot-powershell", "name": "settings-open-powershell" },

        // ↓ leaves the search field for the list: the cursor is on the first setting, then on the next one.
        { "type": "key", "key": "ArrowDown" },
        { "type": "stable" },
        { "type": "assert", "matches": "☛\\s*≡\\s+Theme" },
        { "type": "key", "key": "ArrowDown" },
        { "type": "stable" },
        { "type": "assert", "matches": "☛\\s*☐\\s+Show welcome tutorial" },
        { "type": "assert", "contains": "Search settings" },
        { "type": "snapshot", "name": "settings-navigated" },

        // Nothing was changed: Esc just closes it.
        { "type": "key", "key": "Escape" },
        { "type": "waitForGone", "text": "Search settings", "timeout": 3000 },
        { "type": "assert", "contains": "No task to run" },
        { "type": "snapshot", "name": "settings-closed" }
    ]
}
