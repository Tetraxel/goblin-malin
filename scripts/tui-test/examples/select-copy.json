{
    // Drag with the left button over text: it is highlighted and, on release, copied (the terminal's OSC 52
    // sequence is in the snapshot's `raw`). The mouse is sent as SGR reports (ESC [ < button ; column ; row M/m,
    // 1-based): button 0 = left, +32 = motion, +8 = Alt. "Hooked" is at columns 43-48 of the first task's row (5).
    "terminal": { "cols": 110, "rows": 40 },
    "dataDir": "scripts/tui-test/fixtures/50-tasks-with-metadata",
    "steps": [
        { "type": "stable", "timeout": 20000 },
        { "type": "wait", "ms": 1000 },
        { "type": "snapshot", "name": "before" },

        { "type": "type", "text": "\u001b[<0;43;5M" },
        { "type": "type", "text": "\u001b[<32;46;5M" },
        { "type": "type", "text": "\u001b[<32;48;5M" },
        { "type": "wait", "ms": 500 },
        { "type": "snapshot", "name": "dragging" },
        { "type": "type", "text": "\u001b[<0;48;5m" },
        { "type": "wait", "ms": 500 },
        { "type": "snapshot", "name": "copied" },

        // A plain click removes the highlight and copies nothing.
        { "type": "type", "text": "\u001b[<0;70;9M" },
        { "type": "type", "text": "\u001b[<0;70;9m" },
        { "type": "wait", "ms": 500 },
        { "type": "snapshot", "name": "clicked" },

        // Alt+drag: a rectangle, two rows of the artist column.
        { "type": "type", "text": "\u001b[<8;32;5M" },
        { "type": "type", "text": "\u001b[<40;37;6M" },
        { "type": "type", "text": "\u001b[<8;37;6m" },
        { "type": "wait", "ms": 500 },
        { "type": "snapshot", "name": "block" },

        // A key press removes the highlight.
        { "type": "key", "key": "Down" },
        { "type": "wait", "ms": 500 },
        { "type": "snapshot", "name": "after-key" }
    ]
}
